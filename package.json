{
  "name": "taskview-ce-monorepo",
  "version": "1.55.0",
  "private": true,
  "description": "TaskView CE monorepo containing web, API, and packages",
  "workspaces": [
    "web",
    "api",
    "taskview-packages/*"
  ],
  "scripts": {
    "dev:webapp": "node init && cd web && pnpm dev",
    "build:webapp": "node init && cd web && pnpm build",
    "build:webapp:dev": "node init && cd web && pnpm build:dev",
    "build:packages": "node init && pnpm --filter=taskview-api --filter=taskview-db-schemas run build",
    "dev:api": "node init && cd api && pnpm dev",
    "build:api": "node init && cd api && pnpm build",
    "install:all": "pnpm install",
    "update:all": "pnpm update -r",
    "clean": "pnpm store prune && rm -rf node_modules",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/node": "^18.19.119",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "pg": "8.20.0"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "arktype": "2.1.20",
    "drizzle-arktype": "0.1.3",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0"
  }
}
